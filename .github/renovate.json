{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranchPatterns": ["main"],
    "dockerfile": {
      "enabled": false
    },
    "gomod": {
      "packageRules": [
        {
            "matchDepTypes": ["indirect"],
            "enabled": false
        }
      ]
    },
    "osvVulnerabilityAlerts": true,
    "timezone": "America/New_York",
    "schedule": ["* 0-8 * * 2"],
    "vulnerabilityAlerts": {
        "enabled": true
    }
}
